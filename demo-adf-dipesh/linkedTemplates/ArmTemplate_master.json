{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "demo-adf-dipesh"
		},
		"LS_SQL_SERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SERVER'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sademodatapractice.dfs.core.windows.net/"
		},
		"LS_SQL_SERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "training-dipesh-sql-server.database.windows.net"
		},
		"LS_SQL_SERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "demo_sql_db"
		},
		"LS_SQL_SERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladminuser"
		},
		"tgr_event_simple_properties_PL_FILE_EVENT_parameters_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"tgr_event_simple_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/95897759-35fd-42ac-8684-922d3100dcff/resourceGroups/rg_training/providers/Microsoft.Storage/storageAccounts/sademodatapractice"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "demo-adf-dipesh_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_SERVER_password": {
						"value": "[parameters('LS_SQL_SERVER_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_server')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_database')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_userName')]"
					},
					"tgr_event_simple_properties_PL_FILE_EVENT_parameters_file_name": {
						"value": "[parameters('tgr_event_simple_properties_PL_FILE_EVENT_parameters_file_name')]"
					},
					"tgr_event_simple_properties_typeProperties_scope": {
						"value": "[parameters('tgr_event_simple_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}